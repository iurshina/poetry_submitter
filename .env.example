# MODEL_MODE controls which LLM backend is used (default: local)
#
# local — Ollama running on your machine (no API key needed)
#   Make sure Ollama is running: ollama serve
#   Make sure the model is pulled: ollama pull qwen3:8b
#
# claude — Anthropic Claude API (requires ANTHROPIC_API_KEY)
#   MODEL_MODE=claude
#   ANTHROPIC_API_KEY=sk-ant-...

MODEL_MODE=local
# ANTHROPIC_API_KEY=
